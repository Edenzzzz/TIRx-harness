+@pytest.mark.parametrize("unroll_hint", [None, True, 2, False])
+def test_serial_dynamic_loop_preserves_explicit_unroll_policy(unroll_hint):
+    @T.prim_func
+    def main(A: T.Buffer((32,), "int32"), count: T.int32):
+        T.device_entry()
+        tx = T.thread_id([32])
+        for index in T.serial(count, unroll=unroll_hint):
+            A[tx] = A[tx] + index
+
+    src, _ = _get_source(main)
+    directive = {None: " 1", True: "", 2: " 2", False: " 1"}[unroll_hint]
+    assert re.search(rf"#pragma unroll{directive}\s*for \(", src)
+
