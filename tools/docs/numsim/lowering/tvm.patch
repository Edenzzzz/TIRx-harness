+UnchangedOr<Stmt> StmtSimplifier::Mutate_(const EvaluateNode* op, InplaceMode inplace_mode) {
+  auto result = Parent::Mutate_(op, inplace_mode);
+  Stmt statement = std::move(result).ValueOrUnchanged(ffi::GetRef<Stmt>(op));
+  const auto* evaluate = statement.as<EvaluateNode>();
+  if (!evaluate) return statement;
+  const auto* call = evaluate->value.as<CallNode>();
+  if (!call || call->args.size() != 4) return statement;
+  const auto* operation = call->op.as<OpNode>();
+  if (!operation || operation->name != "tirx.ptx.mov") return statement;
+  const auto* modifier = call->args[2].as<StringImmNode>();
+  const auto* flags = call->args[3].as<StringImmNode>();
+  if (!modifier || !flags || !flags->value.empty() || modifier->value == "pred") return statement;
+  const auto* destination = call->args[0].as<TensorLoadNode>();
+  auto value = call->args[1].as<PrimExpr>();
+  if (!destination || !value || !destination->source.as<BufferVar>() ||
+      destination->ty != value->ty()) {
+    return statement;
+  }
+  BufferVar buffer = destination->source.as_or_throw<BufferVar>();
+  PrimType dtype = value->ty();
+  if (buffer.scope() != "local" || !dtype.IsScalar() ||
+      !(dtype.MatchesCode(DLDataTypeCode::kDLInt, DLDataTypeCode::kDLUInt) ||
+        dtype == PrimType::Float(32) || dtype == PrimType::Float(64))) {
+    return statement;
+  }
+  if (dtype.bits() != 16 && dtype.bits() != 32 && dtype.bits() != 64) return statement;
+  std::string width = std::to_string(dtype.bits());
+  bool valid_modifier =
+      modifier->value == "b" + width ||
+      (dtype.MatchesCode(DLDataTypeCode::kDLInt) && modifier->value == "s" + width) ||
+      (dtype.MatchesCode(DLDataTypeCode::kDLUInt) && modifier->value == "u" + width) ||
+      (dtype.MatchesCode(DLDataTypeCode::kDLFloat) && modifier->value == "f" + width);
+  if (!valid_modifier) return statement;
+  return BufferStore(buffer, value.value(), destination->indices, statement->span);
+}
