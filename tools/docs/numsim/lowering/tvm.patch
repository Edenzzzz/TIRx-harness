+inline std::vector<size_t> ScalarParameterGroups(const tirx::PrimFunc& function) {
+  auto target = function->GetAttr<Target>(tvm::attr::kTarget);
+  if (!target || target.value()->kind->name != "cuda" ||
+      function->GetAttr<CallingConv>(tvm::attr::kCallingConv, CallingConv::kDefault).value() !=
+          CallingConv::kDeviceKernelLaunch) {
+    return {};
+  }
+  struct Collector : tirx::StmtExprVisitor {
+    explicit Collector(tirx::PrimFunc function) : function(std::move(function)) {}
+    tirx::PrimFunc function;
+    std::set<size_t> starts;
+    std::set<const VarNode*> escaped;
+
+    ffi::Optional<VisitInterrupt> Visit_(const prim::SelectNode* op) final {
+      auto table = MatchScalarParameterTable(op);
+      if (table && IsSafeScalarTableIndex(table->selector)) {
+        for (size_t start = 0; start + 4 <= function->params.size(); ++start) {
+          bool matches = true;
+          auto dtype = function->params[start]->ty.as<PrimType>();
+          if (!dtype || !dtype->IsScalar() || (dtype->bits() != 32 && dtype->bits() != 64) ||
+              !(dtype->MatchesCode(DLDataTypeCode::kDLInt, DLDataTypeCode::kDLUInt,
+                                   DLDataTypeCode::kDLFloat))) {
+            continue;
+          }
+          for (size_t field = 0; field < 4; ++field) {
+            matches &= function->params[start + field].same_as(table->values[field]) &&
+                       function->params[start + field]->ty == *dtype;
+          }
+          if (matches) starts.insert(start);
+        }
+      }
+      return StmtExprVisitor::Visit_(op);
+    }
+
+    ffi::Optional<VisitInterrupt> Visit_(const CallNode* op) final {
+      const auto* operation = op->op.as<OpNode>();
+      if (!operation || operation->name == "tirx.address_of" ||
+          operation->name == "prim.address_of" || operation->name == "tirx.cuda.func_call" ||
+          operation->name == "tirx.call_extern") {
+        for (const auto& argument : op->args) {
+          if (const auto* variable = argument.as<VarNode>()) escaped.insert(variable);
+        }
+      }
+      return StmtExprVisitor::Visit_(op);
+    }
+  };
+  auto collector = ffi::make_object<Collector>(function);
+  collector->Visit(function->body);
+  std::vector<size_t> groups;
+  for (size_t start : collector->starts) {
+    if (!groups.empty() && start < groups.back() + 4) continue;
+    bool escaped = false;
+    for (size_t field = 0; field < 4; ++field) {
+      escaped |= collector->escaped.count(function->params[start + field].get()) != 0;
+    }
+    if (!escaped) groups.push_back(start);
+  }
+  return groups;
+}
