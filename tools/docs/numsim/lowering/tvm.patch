+struct ScalarParameterTable {
+  PrimExpr selector;
+  ffi::Array<tirx::Var> values;
+};
+
+inline std::optional<ScalarParameterTable> MatchScalarParameterTable(
+    const prim::SelectNode* source) {
+  std::optional<PrimExpr> selector;
+  std::map<int, tirx::Var> values;
+  PrimExpr current = ffi::GetRef<PrimExpr>(source);
+  while (const auto* selected = current.as<prim::SelectNode>()) {
+    const auto* condition = selected->condition.as<prim::EQNode>();
+    auto value = selected->true_value.as<tirx::Var>();
+    if (!condition || !value) return std::nullopt;
+    const auto* index = condition->b.as<prim::IntImmNode>();
+    PrimExpr expression = condition->a;
+    if (!index) {
+      index = condition->a.as<prim::IntImmNode>();
+      expression = condition->b;
+    }
+    if (!index) return std::nullopt;
+    auto constant = index->value.as<int64_t>();
+    if (!constant || *constant < 1 || *constant > 3) return std::nullopt;
+    if (selector && !prim::ExprDeepEqual()(*selector, expression)) return std::nullopt;
+    selector = expression;
+    if (!values.emplace(static_cast<int>(*constant), *value).second) return std::nullopt;
+    current = selected->false_value;
+  }
+  auto fallback = current.as<tirx::Var>();
+  if (!fallback || !selector || values.size() != 3) return std::nullopt;
+  values.emplace(0, *fallback);
+  ffi::Array<tirx::Var> fields;
+  for (int index = 0; index < 4; ++index) fields.push_back(values.at(index));
+  return ScalarParameterTable{*selector, fields};
+}
+
+class ScalarTableIndexValidator : public tirx::StmtExprVisitor {
+ public:
+  bool valid{true};
+
+ private:
+  ffi::Optional<VisitInterrupt> Visit_(const TensorLoadNode* op) final {
+    auto buffer = op->source.as<tirx::BufferVar>();
+    if (!buffer || buffer->scope() != "local") {
+      valid = false;
+      return std::nullopt;
+    }
+    return StmtExprVisitor::Visit_(op);
+  }
+
+  ffi::Optional<VisitInterrupt> Visit_(const CallNode* op) final {
+    auto expression = ffi::GetRef<Expr>(op).as<PrimExpr>();
+    if (!expression || SideEffect(*expression) > CallEffectKind::kPure) {
+      valid = false;
+      return std::nullopt;
+    }
+    return StmtExprVisitor::Visit_(op);
+  }
+};
+
+inline bool IsSafeScalarTableIndex(const PrimExpr& expression) {
+  PrimType dtype = expression.ty();
+  if (!dtype.IsScalar() || !dtype.MatchesCode(DLDataTypeCode::kDLInt, DLDataTypeCode::kDLUInt)) {
+    return false;
+  }
+  auto validator = ffi::make_object<ScalarTableIndexValidator>();
+  validator->Visit(expression);
+  return validator->valid;
+}
